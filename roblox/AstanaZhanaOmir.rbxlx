<Item class="ModuleScript" referent="RBX0003">
<Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Общие настройки игры «Астана: Жаңа өмір» (Roblox).
-- Здесь только данные: цены, предметы, точки на карте. Логика — в Logic.luau.

local Config = {}

Config.SAVE_VERSION = 1
Config.DATASTORE = "AstanaZhanaOmir_v1"

-- Время: одна игровая минута длится 0.5 секунды, сутки — 12 минут.
Config.SECONDS_PER_GAME_MINUTE = 0.5
Config.START_HOUR = 10
Config.RENT_HOUR = 8

Config.START_MONEY = 15000
Config.RENT = 5000
Config.BUS_FARE = 100
Config.HOSPITAL_BILL = 5000
Config.FLAT_PRICE = 1200000

Config.WALK_SPEED = 16
Config.SCOOTER_SPEED = 27

Config.XP_PER_LEVEL = 100
Config.MAX_LEVEL = 5
Config.INTERVIEW_KAZ = 3
Config.INTERVIEW_CODE = 3

Config.KAZ_LESSON_PRICE = 500
Config.LESSON_QUESTIONS = 5
Config.KAZ_XP = 12
Config.CODE_XP = 10
Config.CODE_XP_LAPTOP = 15

Config.COURIER_BASE = 800
Config.COURIER_PER_STUD = 6
Config.COURIER_ENERGY = 6
Config.COURIER_MIN_DISTANCE = 140

Config.BARISTA_PAY = 1200
Config.BARISTA_ENERGY = 15
Config.BARISTA_COOLDOWN = 180 -- игровых минут
Config.BARISTA_OPEN = 7
Config.BARISTA_CLOSE = 21

Config.IT_PAY = 15000
Config.IT_PAY_FAIL = 2000
Config.IT_ENERGY = 20
Config.IT_COOLDOWN = 60

export type Item = {
	id: string,
	name: string,
	price: number,
	desc: string,
	food: number?,
	energy: number?,
	warmth: number?,
	warm: number?, -- тепло одежды
	slot: string?, -- "outer" | "hat" | "key"
}

Config.ITEMS = {
	samsa = { id = "samsa", name = "Самса", price = 400, desc = "Из тандыра, с мясом", food = 22 },
	baursak = { id = "baursak", name = "Баурсаки", price = 300, desc = "Пышные, ещё тёплые", food = 20 },
	kurt = { id = "kurt", name = "Курт", price = 150, desc = "Солёные шарики из творога", food = 8 },
	kumys = { id = "kumys", name = "Кумыс", price = 500, desc = "Бодрит", food = 10, energy = 8 },
	tea = { id = "tea", name = "Горячий чай с молоком", price = 200, desc = "Согревает", food = 3, warmth = 35 },
	doner = { id = "doner", name = "Донер", price = 900, desc = "Большой, с собой", food = 45 },
	lagman = { id = "lagman", name = "Лагман", price = 1400, desc = "Горячий и сытный", food = 60, warmth = 20 },
	cappuccino = { id = "cappuccino", name = "Капучино", price = 700, desc = "Тепло и бодрость", energy = 15, warmth = 15 },
	puffer = { id = "puffer", name = "Пуховик", price = 12000, desc = "Без него зимой никак", warm = 3, slot = "outer" },
	ushanka = { id = "ushanka", name = "Ушанка", price = 2500, desc = "Уши в тепле", warm = 1, slot = "hat" },
	pufferN = { id = "pufferN", name = "Пуховик «Солтүстік»", price = 45000, desc = "Держит до −40", warm = 4, slot = "outer" },
	scooter = { id = "scooter", name = "Электросамокат", price = 60000, desc = "Двигаешься намного быстрее", slot = "key" },
	laptop = { id = "laptop", name = "Ноутбук", price = 120000, desc = "Можно учить код дома", slot = "key" },
} :: { [string]: Item }

Config.SHOPS = {
	bazaar = { title = "Базар", text = "Подходи, бауырым, всё свежее!", items = { "samsa", "baursak", "kurt", "kumys", "tea", "puffer", "ushanka" } },
	doner = { title = "Шаурма №1", text = "Что будем заказывать?", items = { "doner", "lagman", "tea" } },
	coffee = { title = "Кофейня «Есіл»", text = "Сәлем! Что приготовить?", items = { "cappuccino", "tea" } },
	mall = { title = "Хан Шатыр", text = "Добро пожаловать в торговый центр!", items = { "pufferN", "scooter", "laptop", "cappuccino" } },
}

Config.BARISTA_INGREDIENTS = { "Эспрессо", "Молоко", "Пенка", "Сироп", "Корица", "Лёд" }

-- Карта. X — восток, Z — юг. Есиль течёт вдоль оси X; правый берег на севере (Z < 0).
Config.RIVER_HALF = 40
Config.MAP_HALF_X = 320
Config.MAP_DEPTH = 360

export type Place = { id: string, name: string, x: number, z: number, w: number, d: number, h: number, door: number, color: { number }, tall: number? }

-- door: 1 — дверь смотрит на юг (+Z), -1 — на север (−Z).
Config.BUILDINGS = {
	{ id = "station", name = "Вокзал", x = -230, z = -160, w = 50, d = 30, h = 16, door = 1, color = { 214, 196, 160 } },
	{ id = "home", name = "Комната у Гульнар-апай", x = -150, z = -158, w = 34, d = 26, h = 14, door = 1, color = { 176, 170, 160 }, tall = 40 },
	{ id = "school", name = "Курсы казахского", x = -80, z = -156, w = 30, d = 22, h = 14, door = 1, color = { 96, 150, 190 } },
	{ id = "hospital", name = "Больница", x = 70, z = -158, w = 44, d = 26, h = 16, door = 1, color = { 235, 235, 235 } },
	{ id = "library", name = "Библиотека", x = 150, z = -156, w = 34, d = 22, h = 14, door = 1, color = { 150, 120, 100 } },
	{ id = "depot", name = "Курьерская служба", x = -190, z = -86, w = 32, d = 22, h = 13, door = -1, color = { 240, 180, 41 } },
	{ id = "doner", name = "Шаурма №1", x = -30, z = -86, w = 26, d = 20, h = 12, door = -1, color = { 200, 80, 60 } },
	{ id = "coffee", name = "Кофейня «Есіл»", x = 60, z = -86, w = 28, d = 20, h = 12, door = -1, color = { 110, 80, 60 } },
	{ id = "it", name = "Qazaq Soft", x = -100, z = 156, w = 36, d = 28, h = 15, door = -1, color = { 90, 140, 200 }, tall = 110 },
	{ id = "flat", name = "ЖК «Есіл»", x = 100, z = 156, w = 36, d = 28, h = 15, door = -1, color = { 230, 225, 215 }, tall = 90 },
	{ id = "mall", name = "Хан Шатыр", x = -220, z = 150, w = 40, d = 22, h = 14, door = -1, color = { 190, 230, 225 } },
} :: { Place }

Config.BAZAAR = { x = -105, z = -84 }
Config.SPAWN = { x = -230, z = -132 }
Config.HOSPITAL_EXIT = { x = 70, z = -134 }
Config.BAITEREK = { x = 0, z = 235, deck = 86 }

Config.BUS_STOPS = {
	{ id = "station", name = "Вокзал", x = -200, z = -131 },
	{ id = "bazaar", name = "Базар", x = -70, z = -109 },
	{ id = "baiterek", name = "Байтерек", x = 24, z = 131 },
	{ id = "shatyr", name = "Хан Шатыр", x = -185, z = 131 },
}

-- Адреса доставки для курьера.
Config.ADDRESSES = {
	{ name = "Вокзал, камера хранения", x = -230, z = -138 },
	{ name = "Библиотека", x = 150, z = -140 },
	{ name = "Больница, приёмный покой", x = 70, z = -138 },
	{ name = "Кофейня «Есіл»", x = 60, z = -102 },
	{ name = "Дом на улице Сейфуллина", x = 230, z = -100 },
	{ name = "Набережная, правый берег", x = 120, z = -52 },
	{ name = "Qazaq Soft, ресепшен", x = -100, z = 136 },
	{ name = "ЖК «Есіл», консьерж", x = 100, z = 136 },
	{ name = "Байтерек, касса", x = 0, z = 205 },
	{ name = "Хан Шатыр, вход", x = -220, z = 133 },
	{ name = "Нұр Әлем", x = 235, z = 200 },
	{ name = "Набережная, левый берег", x = -130, z = 52 },
}

Config.PED_LINES = {
	"Ветер сегодня такой, что шапку уносит до Караганды.",
	"Летом +35, зимой −40. Астана закаляет!",
	"Байтерек — 97 метров. В честь 1997 года, когда сюда перенесли столицу.",
	"Наверху Байтерека есть отпечаток ладони. Приложи руку и загадай желание!",
	"Я из Шымкента. Тут, конечно, холоднее… раз в десять.",
	"Опять пробка на мосту. Как обычно.",
	"Мой дедушка помнит, когда город назывался Целиноград.",
	"Говорят, шар EXPO — самое большое сферическое здание в мире.",
	"Зимой Есиль замерзает — можно идти прямо по льду!",
	"Бешбармак лучше всего у мамы. Ну или на тое.",
	"Байтерек — это дерево жизни, а золотой шар — яйцо птицы Самрук.",
	"В Астане два сезона: зима и ремонт дорог.",
	"−30 и ветер. Обычный вторник.",
	"Пуховик — лучшая инвестиция в Астане.",
	"Буран обещали. Беги в тепло, пока автобусы ходят.",
}

return Config
]]></ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX0004">
<Properties><string name="Name">Logic</string><ProtectedString name="Source"><![CDATA[--!strict
-- Чистая игровая логика без обращений к Roblox API: её можно проверять тестами.

local Config = require(script.Parent.Config)

local Logic = {}

export type State = {
	version: number,
	money: number,
	energy: number,
	food: number,
	warmth: number,
	kazXp: number,
	codeXp: number,
	day: number,
	debt: number,
	items: { [string]: boolean },
	hired: boolean,
	ownsFlat: boolean,
	deliveries: number,
	shifts: number,
	itTasks: number,
	wishDay: number,
	wished: boolean,
	interviewDay: number,
}

export type Env = { indoors: boolean, temp: number, buran: boolean }

function Logic.newState(): State
	return {
		version = Config.SAVE_VERSION,
		money = Config.START_MONEY,
		energy = 100,
		food = 80,
		warmth = 100,
		kazXp = 0,
		codeXp = 0,
		day = 1,
		debt = 0,
		items = {},
		hired = false,
		ownsFlat = false,
		deliveries = 0,
		shifts = 0,
		itTasks = 0,
		wishDay = 0,
		wished = false,
		interviewDay = 0,
	}
end

-- Приводит сохранённые данные к актуальному виду: неизвестное отбрасывает, недостающее дополняет.
function Logic.sanitize(saved: any): State
	local state = Logic.newState()
	if type(saved) ~= "table" then
		return state
	end
	local target = state :: any
	for key, default in pairs(target) do
		local value = saved[key]
		if key ~= "items" and type(value) == type(default) then
			if type(value) == "number" and (value ~= value or math.abs(value) == math.huge) then
				continue
			end
			target[key] = value
		end
	end
	if type(saved.items) == "table" then
		for id, owned in pairs(saved.items) do
			if owned == true and Config.ITEMS[id] and Config.ITEMS[id].slot then
				state.items[id] = true
			end
		end
	end
	state.version = Config.SAVE_VERSION
	state.energy = math.clamp(state.energy, 0, 100)
	state.food = math.clamp(state.food, 0, 100)
	state.warmth = math.clamp(state.warmth, 0, 100)
	state.money = math.max(0, math.floor(state.money))
	state.debt = math.max(0, math.floor(state.debt))
	state.day = math.max(1, math.floor(state.day))
	return state
end

function Logic.level(xp: number): number
	return math.min(Config.MAX_LEVEL, math.floor(xp / Config.XP_PER_LEVEL))
end

function Logic.addXp(state: State, skill: "kazXp" | "codeXp", amount: number)
	local cap = Config.MAX_LEVEL * Config.XP_PER_LEVEL
	state[skill] = math.min(cap, state[skill] + amount)
end

-- Суммарное тепло одежды: лучшая верхняя одежда плюс шапка.
function Logic.warmRating(state: State): number
	local outer, hat = 0, 0
	for id in pairs(state.items) do
		local item = Config.ITEMS[id]
		if item and item.warm then
			if item.slot == "outer" then
				outer = math.max(outer, item.warm)
			elseif item.slot == "hat" then
				hat = math.max(hat, item.warm)
			end
		end
	end
	return outer + hat
end

function Logic.walkSpeed(state: State): number
	return if state.items.scooter then Config.SCOOTER_SPEED else Config.WALK_SPEED
end

-- Температура на улице по часу суток.
function Logic.temperature(hour: number, buran: boolean): number
	local wave = math.cos((hour - 15) / 24 * 2 * math.pi) -- максимум в 15:00
	local temp = -18 + 6 * wave
	if buran then
		temp -= 9
	end
	return math.floor(temp + 0.5)
end

-- Сколько тепла уходит за игровую минуту на улице.
function Logic.coldDrain(state: State, env: Env): number
	local coldness = math.max(0, 5 - env.temp) / 10
	if env.buran then
		coldness *= 1.8
	end
	local protection = math.max(0.08, 1 - 0.2 * Logic.warmRating(state))
	return coldness * 0.25 * protection
end

-- Продвигает потребности на указанное число игровых минут.
-- Возвращает причину обморока ("cold" | "tired") или nil.
function Logic.tick(state: State, minutes: number, env: Env): string?
	state.food = math.max(0, state.food - 0.085 * minutes)
	local energyDrain = if state.food <= 0 then 0.27 else 0.09
	state.energy = math.max(0, state.energy - energyDrain * minutes)
	if env.indoors then
		state.warmth = math.min(100, state.warmth + 3 * minutes)
	else
		state.warmth = math.max(0, state.warmth - Logic.coldDrain(state, env) * minutes)
	end
	if state.warmth <= 0 then
		return "cold"
	elseif state.energy <= 0 then
		return "tired"
	end
	return nil
end

-- Обморок: очнулся в больнице, заплатил по счёту. Возвращает сумму счёта.
function Logic.faint(state: State): number
	state.energy = math.max(state.energy, 45)
	state.food = math.max(state.food, 30)
	state.warmth = math.max(state.warmth, 70)
	local bill = math.min(state.money, Config.HOSPITAL_BILL)
	state.money -= bill
	return bill
end

function Logic.canAfford(state: State, price: number): boolean
	return state.money >= price
end

-- Покупка предмета. Возвращает успех и сообщение для игрока.
function Logic.buy(state: State, itemId: string): (boolean, string)
	local item = Config.ITEMS[itemId]
	if not item then
		return false, "Такого товара нет."
	end
	if item.slot and state.items[itemId] then
		return false, `У тебя уже есть: {item.name}.`
	end
	if state.money < item.price then
		return false, `Не хватает денег: нужно {Logic.money(item.price)}.`
	end
	state.money -= item.price
	if item.slot then
		state.items[itemId] = true
		return true, `Куплено: {item.name}.`
	end
	state.food = math.min(100, state.food + (item.food or 0))
	state.energy = math.min(100, state.energy + (item.energy or 0))
	state.warmth = math.min(100, state.warmth + (item.warmth or 0))
	return true, `{item.name} — вкусно!`
end

-- Новое утро: списывает аренду. Возвращает сообщение.
function Logic.newDay(state: State): string
	state.day += 1
	if state.ownsFlat then
		return `День {state.day}. Доброе утро в своей квартире!`
	end
	if state.money >= Config.RENT then
		state.money -= Config.RENT
		return `День {state.day}. Аренда комнаты: −{Logic.money(Config.RENT)}.`
	end
	state.debt += Config.RENT
	return `День {state.day}. Нечем платить за комнату! Долг: {Logic.money(state.debt)}.`
end

function Logic.payDebt(state: State): (boolean, string)
	if state.debt <= 0 then
		return false, "Долгов нет."
	end
	if state.money < state.debt then
		return false, `Нужно {Logic.money(state.debt)}, а у тебя {Logic.money(state.money)}.`
	end
	state.money -= state.debt
	state.debt = 0
	return true, "Долг за комнату погашен. Гульнар-апай довольна."
end

function Logic.canInterview(state: State): boolean
	return Logic.level(state.kazXp) >= Config.INTERVIEW_KAZ and Logic.level(state.codeXp) >= Config.INTERVIEW_CODE
end

function Logic.courierPay(distance: number): number
	local raw = Config.COURIER_BASE + distance * Config.COURIER_PER_STUD
	return math.floor(raw / 100 + 0.5) * 100
end

function Logic.baristaPay(state: State, correct: number): number
	local tips = 1 + 0.1 * Logic.level(state.kazXp)
	return math.floor(Config.BARISTA_PAY * correct * tips / 100 + 0.5) * 100
end

-- Подсказка: что делать дальше.
function Logic.goal(state: State): string
	if state.ownsFlat then
		return "У тебя своя квартира на левом берегу. Астана — твой дом!"
	end
	if state.debt > 0 then
		return `Погаси долг за комнату: {Logic.money(state.debt)} (Гульнар-апай, дома)`
	end
	if Logic.warmRating(state) == 0 then
		return "Купи пуховик на базаре — на улице мороз. Заработать можно курьером."
	end
	if state.hired then
		return `Работай в Qazaq Soft и копи на квартиру в ЖК «Есіл»: {Logic.money(Config.FLAT_PRICE)}`
	end
	if Logic.level(state.kazXp) < Config.INTERVIEW_KAZ then
		return `Учи казахский на курсах: уровень {Logic.level(state.kazXp)} из {Config.INTERVIEW_KAZ}`
	end
	if Logic.level(state.codeXp) < Config.INTERVIEW_CODE then
		return `Учи код в библиотеке: уровень {Logic.level(state.codeXp)} из {Config.INTERVIEW_CODE}`
	end
	return "Иди на собеседование в Qazaq Soft на левом берегу"
end

-- 1234567 → "1 234 567 ₸"
function Logic.money(amount: number): string
	local digits = tostring(math.floor(math.abs(amount)))
	local out = digits:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	out = out:gsub("^%s+", "")
	return (if amount < 0 then "−" else "") .. out .. " ₸"
end

function Logic.clock(minuteOfDay: number): string
	local hours = math.floor(minuteOfDay / 60) % 24
	local minutes = math.floor(minuteOfDay % 60)
	return string.format("%02d:%02d", hours, minutes)
end

return Logic
]]></ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX0005">
<Properties><string name="Name">Questions</string><ProtectedString name="Source"><![CDATA[--!strict
-- Вопросы для уроков казахского и для задач по коду.

local Questions = {}

-- Казахское слово → перевод. Неверные варианты берутся из других пар.
Questions.KAZ = {
	{ "Сәлем", "Привет" },
	{ "Рақмет", "Спасибо" },
	{ "Сау бол", "Пока" },
	{ "Иә", "Да" },
	{ "Жоқ", "Нет" },
	{ "Нан", "Хлеб" },
	{ "Су", "Вода" },
	{ "Сүт", "Молоко" },
	{ "Ет", "Мясо" },
	{ "Шай", "Чай" },
	{ "Қала", "Город" },
	{ "Көше", "Улица" },
	{ "Үй", "Дом" },
	{ "Жұмыс", "Работа" },
	{ "Ақша", "Деньги" },
	{ "Дос", "Друг" },
	{ "Ана", "Мама" },
	{ "Әке", "Папа" },
	{ "Әже", "Бабушка" },
	{ "Ата", "Дедушка" },
	{ "Қыс", "Зима" },
	{ "Жаз", "Лето" },
	{ "Қар", "Снег" },
	{ "Жел", "Ветер" },
	{ "Суық", "Холодно" },
	{ "Ыстық", "Жарко" },
	{ "Күн", "Солнце" },
	{ "Түн", "Ночь" },
	{ "Таң", "Утро" },
	{ "Өзен", "Река" },
	{ "Көпір", "Мост" },
	{ "Кітап", "Книга" },
	{ "Мектеп", "Школа" },
	{ "Дүкен", "Магазин" },
	{ "Базар", "Рынок" },
	{ "Жаңа", "Новый" },
	{ "Өмір", "Жизнь" },
	{ "Үлкен", "Большой" },
	{ "Кішкентай", "Маленький" },
	{ "Жақсы", "Хорошо" },
	{ "Бір", "Один" },
	{ "Екі", "Два" },
	{ "Үш", "Три" },
	{ "Бүгін", "Сегодня" },
	{ "Ертең", "Завтра" },
	{ "Астана", "Столица" },
}

-- { вопрос, { варианты }, номер верного }
Questions.CODE = {
	{ "Что выведет print(2 + 3 * 4)?", { "20", "14", "24", "9" }, 2 },
	{ "Как называется ошибка в программе?", { "Баг", "Бит", "Байт", "Лаг" }, 1 },
	{ "Сколько бит в одном байте?", { "4", "10", "8", "16" }, 3 },
	{ "Что делает цикл?", { "Повторяет действия", "Удаляет файл", "Рисует окно", "Выключает компьютер" }, 1 },
	{ "Какое значение бывает у типа boolean?", { "Число", "true или false", "Строка", "Список" }, 2 },
	{ "С какого номера начинается массив в Lua?", { "0", "−1", "1", "10" }, 3 },
	{ "Что такое переменная?", { "Имя, под которым хранится значение", "Кнопка на клавиатуре", "Тип монитора", "Вирус" }, 1 },
	{ "Что вернёт 10 % 3?", { "3", "0", "1", "10" }, 3 },
	{ "Как в Lua пишут «не равно»?", { "!=", "<>", "~=", "=/=" }, 3 },
	{ "Что делает оператор if?", { "Проверяет условие", "Повторяет код", "Создаёт файл", "Складывает числа" }, 1 },
	{ "Как называют систему для хранения версий кода?", { "Git", "Zip", "Wi-Fi", "PDF" }, 1 },
	{ "Что такое функция?", { "Именованный кусок кода, который можно вызвать", "Картинка", "Папка", "Пароль" }, 1 },
	{ "Чему равно true and false?", { "true", "false", "nil", "Ошибка" }, 2 },
	{ "Чему равно true or false?", { "true", "false", "nil", "Ошибка" }, 1 },
	{ "Что значит nil в Lua?", { "Ноль", "Отсутствие значения", "Пустая строка", "Ошибка" }, 2 },
	{ "Какой оператор склеивает строки в Lua?", { "+", "&", "..", "::" }, 3 },
	{ "Что выведет print(#\"kod\")?", { "2", "3", "4", "kod" }, 2 },
	{ "Сервер в игре — это…", { "Компьютер, который ведёт общий мир для всех игроков", "Экран игрока", "Мышка", "Наушники" }, 1 },
	{ "Что такое бесконечный цикл?", { "Цикл, который никогда не заканчивается", "Очень быстрый цикл", "Цикл из одной строки", "Цикл без переменных" }, 1 },
	{ "Зачем пишут комментарии в коде?", { "Чтобы объяснить код людям", "Чтобы код работал быстрее", "Чтобы спрятать ошибки", "Их требует компьютер" }, 1 },
	{ "Двоичное число 101 — это в десятичной…", { "3", "5", "101", "6" }, 2 },
	{ "Что такое API?", { "Способ, которым программы общаются между собой", "Марка ноутбука", "Вид вируса", "Язык разметки" }, 1 },
	{ "Что произойдёт при делении 7 // 2 (целочисленном)?", { "3.5", "4", "3", "2" }, 3 },
	{ "Таблица в Lua — это…", { "Набор значений по ключам", "Только числа", "Картинка", "Файл на диске" }, 1 },
	{ "Что такое отладка (debug)?", { "Поиск и исправление ошибок", "Удаление программы", "Покупка сервера", "Рисование интерфейса" }, 1 },
}

export type Question = { text: string, options: { string }, answer: number }

local function shuffle<T>(list: { T }, rng: Random): { T }
	local copy = table.clone(list)
	for i = #copy, 2, -1 do
		local j = rng:NextInteger(1, i)
		copy[i], copy[j] = copy[j], copy[i]
	end
	return copy
end

function Questions.kaz(rng: Random): Question
	local pool = Questions.KAZ
	local index = rng:NextInteger(1, #pool)
	local pair = pool[index]
	local options = { pair[2] }
	while #options < 4 do
		local other = pool[rng:NextInteger(1, #pool)][2]
		if not table.find(options, other) then
			table.insert(options, other)
		end
	end
	options = shuffle(options, rng)
	return {
		text = `Как переводится «{pair[1]}»?`,
		options = options,
		answer = table.find(options, pair[2]) :: number,
	}
end

function Questions.code(rng: Random): Question
	local raw = Questions.CODE[rng:NextInteger(1, #Questions.CODE)]
	local correct = raw[2][raw[3]]
	local options = shuffle(raw[2], rng)
	return { text = raw[1], options = options, answer = table.find(options, correct) :: number }
end

return Questions
]]></ProtectedString></Properties>
</Item>
